pkgname=arkade-cli-bin
pkgver=0.9.16
pkgrel=1
pkgdesc="Ark Wallet CLI (prebuilt ark from arkade-os/arkd) for Arch / Omarchy"
arch=('x86_64' 'aarch64')
url="https://github.com/theDavidCoen/arkade-cli"
license=('MIT')
provides=('arkade-cli' 'ark')
conflicts=('arkade-cli' 'ark')
options=('!strip')

source_x86_64=("ark-linux-amd64::https://github.com/arkade-os/arkd/releases/download/v${pkgver}/ark-linux-amd64")
source_aarch64=("ark-linux-arm64::https://github.com/arkade-os/arkd/releases/download/v${pkgver}/ark-linux-arm64")
source=('NOTICE' 'LICENSE')

sha256sums=(
  '4b5f213917bb34469507b61f69785fb95a0c59095b4f0fcdb610c03770c42dec'
  '3a63da9bd43051e0d09e679997e7091cf6e021b4851eb5772c30a8b14aef5ac9'
)
sha256sums_x86_64=('56f9a667bdf035f11617169fd90a9dfe81640f90797196136f16d520cc4300a5')
sha256sums_aarch64=('eefbcf3870cdfd191310e495a583cd87a0b3ac8a6a0a3f0232651c9eeeadc29a')

package() {
  local bin
  case "$CARCH" in
    x86_64) bin=ark-linux-amd64 ;;
    aarch64) bin=ark-linux-arm64 ;;
    *) echo "unsupported arch: $CARCH" >&2; return 1 ;;
  esac

  install -Dm755 "$srcdir/$bin" "$pkgdir/usr/bin/ark"
  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/NOTICE" "$pkgdir/usr/share/doc/$pkgname/NOTICE"
}
